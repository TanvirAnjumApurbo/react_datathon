# Virtualenv
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editor
.vscode/
.idea/

# Competition data -- not redistributed. Download train.csv / test.csv /
# sample_submission.csv from the Kaggle competition page into data/.
data/*.csv

# Built feature matrices and model caches (~800 MB, rebuilt by
# `build_features.py`). The small provenance artefacts are kept -- see below.
data/processed/*
!data/processed/feature_manifest.json
!data/processed/feature_gain.csv
!data/processed/search_results.csv
!data/processed/blend_spec.json
# The measurement record. These are small, and they are the evidence behind
# every claim in README.md and SUBMISSIONS.md -- losing them would leave the
# conclusions unfalsifiable.
!data/processed/baseline_results.csv
!data/processed/adversarial_features.csv
!data/processed/adversarial_by_week.csv
!data/processed/adversarial_drop_order.csv
!data/processed/ablation_results.csv
!data/processed/fold_results.csv
!data/processed/tune_results.csv
!data/processed/tune_rounds.json
# The pinned round counts behind submissions 4-10. Early stopping is not stable
# across feature rebuilds (lgb_deep: 230 rounds one day, 758 the next), so this
# file is part of what identifies those models -- naming the members is not
# enough to reproduce them.
!data/processed/tune_rounds.s5_asbuilt.json
!data/processed/postprocess_results.csv
!data/processed/blend_spec_v2.json
!data/processed/blend_spec_equal_all.json

# Submission CSVs are ~9 MB each and reproducible from submit.py; the sidecar
# JSON that records what produced each one is the part worth keeping.
submissions/*.csv

.aider*

# Kaggle upload staging. `matrix_upload/` is the 395 MB feature matrix that makes
# the reproducibility notebook byte-exact, and `react2026_src.zip` is a rebuildable
# archive of tracked source -- neither belongs in the repository.
matrix_upload/
react2026_src.zip

# Kaggle run outputs. The CSVs are ~8 MB each and are reproduced by the notebook;
# the rendered figures are small and are kept as evidence the run executed.
results/*.csv

# LaTeX build artefacts
report/*.aux
report/*.log
report/*.out
report/build.log
